{
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:react-hooks/recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "plugins": [
    "@typescript-eslint",
    "react-hooks"
  ],
  "root": true,
  "env": {
    "browser": true,
    "node": true,
    "es6": true
  },
  "rules": {
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "no-console": [
      "warn",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "react-hooks/exhaustive-deps": "warn",
    "react-hooks/set-state-in-effect": "off",
    "react-hooks/preserve-manual-memoization": "off"
  },
  "overrides": [
    {
      "files": [
        "src/app/(app)/**/*.{ts,tsx}",
        "src/app/(auth)/**/*.{ts,tsx}",
        "src/components/**/*.{ts,tsx}"
      ],
      "excludedFiles": [
        "src/components/landing/**"
      ],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "selector": "Literal[value=/bg-gradient-|linear-gradient|radial-gradient/], TemplateElement[value.raw=/bg-gradient-|linear-gradient|radial-gradient/]",
            "message": "No gradients in the app UI. Use a solid token color."
          },
          {
            "selector": "Literal[value=/animate-(spin|pulse|bounce|ping)/], TemplateElement[value.raw=/animate-(spin|pulse|bounce|ping)/]",
            "message": "No loading animations. Use static text for loading states."
          },
          {
            "selector": "Literal[value=/\\b(bg|text|border|ring|from|to|via|fill|stroke)-(red|green|blue|amber|emerald|rose|yellow|orange|purple|violet|pink|sky|indigo|teal|cyan|lime|fuchsia|slate|zinc|neutral|stone)-[0-9]{2,3}/], TemplateElement[value.raw=/\\b(bg|text|border|ring|from|to|via|fill|stroke)-(red|green|blue|amber|emerald|rose|yellow|orange|purple|violet|pink|sky|indigo|teal|cyan|lime|fuchsia|slate|zinc|neutral|stone)-[0-9]{2,3}/]",
            "message": "Use the project color tokens (success, danger, warning, info, accent-purple, primary, gray-*) instead of raw Tailwind palette colors."
          },
          {
            "selector": "Literal[value=/\\b(drop-)?shadow-\\[0_0_/], TemplateElement[value.raw=/\\b(drop-)?shadow-\\[0_0_/]",
            "message": "No glow shadows. The UI is flat."
          },
          {
            "selector": "Literal[value=/\\btext-\\[[0-9.]+(px|rem|em)\\]/], TemplateElement[value.raw=/\\btext-\\[[0-9.]+(px|rem|em)\\]/]",
            "message": "Use the type scale (text-xs, text-sm, text-body-md, text-heading-lg, ...). No arbitrary text sizes, and nothing below 12px."
          },
          {
            "selector": "Literal[value=/\\bfont-(serif|display)\\b/], TemplateElement[value.raw=/\\bfont-(serif|display)\\b/]",
            "message": "Use font-sans for text and font-mono for numbers. font-brand is for the wordmark and page titles only."
          },
          {
            "selector": "Literal[value=/(^|\\s)uppercase(\\s|$)/], TemplateElement[value.raw=/(^|\\s)uppercase(\\s|$)/]",
            "message": "No uppercase labels in the app UI. Use sentence case."
          },
          {
            "selector": "Literal[value=/\\btracking-(wide|wider|widest)\\b/], TemplateElement[value.raw=/\\btracking-(wide|wider|widest)\\b/]",
            "message": "No wide letter spacing in the app UI. It only served the uppercase labels."
          },
          {
            "selector": "Literal[value=/text-muted-foreground[^\"]*\\sopacity-[1-8]0\\b/], TemplateElement[value.raw=/text-muted-foreground[^\"]*\\sopacity-[1-8]0\\b/]",
            "message": "Muted text with extra opacity fails contrast. text-muted-foreground is already the secondary color."
          },
          {
            "selector": "Literal[value=/(^|\\s)text-muted-foreground\\/[0-9]+/], TemplateElement[value.raw=/(^|\\s)text-muted-foreground\\/[0-9]+/]",
            "message": "Muted text with extra opacity fails contrast. text-muted-foreground is already the secondary color."
          }
        ]
      }
    },
    {
      "files": [
        "src/app/(landing)/**/*.{ts,tsx}",
        "src/components/landing/**/*.{ts,tsx}"
      ],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "selector": "Literal[value=/bg-gradient-|linear-gradient|radial-gradient/], TemplateElement[value.raw=/bg-gradient-|linear-gradient|radial-gradient/]",
            "message": "No gradients in the app UI. Use a solid token color."
          },
          {
            "selector": "Literal[value=/animate-(spin|pulse|bounce|ping)/], TemplateElement[value.raw=/animate-(spin|pulse|bounce|ping)/]",
            "message": "No loading animations. Use static text for loading states."
          },
          {
            "selector": "Literal[value=/\\b(bg|text|border|ring|from|to|via|fill|stroke)-(red|green|blue|amber|emerald|rose|yellow|orange|purple|violet|pink|sky|indigo|teal|cyan|lime|fuchsia|slate|zinc|neutral|stone)-[0-9]{2,3}/], TemplateElement[value.raw=/\\b(bg|text|border|ring|from|to|via|fill|stroke)-(red|green|blue|amber|emerald|rose|yellow|orange|purple|violet|pink|sky|indigo|teal|cyan|lime|fuchsia|slate|zinc|neutral|stone)-[0-9]{2,3}/]",
            "message": "Use the project color tokens (success, danger, warning, info, accent-purple, primary, gray-*) instead of raw Tailwind palette colors."
          },
          {
            "selector": "Literal[value=/\\b(drop-)?shadow-\\[0_0_/], TemplateElement[value.raw=/\\b(drop-)?shadow-\\[0_0_/]",
            "message": "No glow shadows. The UI is flat."
          },
          {
            "selector": "Literal[value=/\\btext-\\[[0-9.]+(px|rem|em)\\]/], TemplateElement[value.raw=/\\btext-\\[[0-9.]+(px|rem|em)\\]/]",
            "message": "Use the type scale (text-xs, text-sm, text-body-md, text-heading-lg, ...). No arbitrary text sizes, and nothing below 12px."
          },
          {
            "selector": "Literal[value=/\\bfont-(serif|display)\\b/], TemplateElement[value.raw=/\\bfont-(serif|display)\\b/]",
            "message": "Use font-sans for text and font-mono for numbers. font-brand is for the wordmark and page titles only."
          }
        ]
      }
    }
  ]
}
